# 課金(RevenueCat)の公開APIキー。開発時は .env.local にコピーして値を入れる。
# EAS ビルドでは eas.json の env かプロジェクトの環境変数として渡す。
#
# ダッシュボード → Project settings → API keys の「Public app-specific API key」。
# 公開鍵なのでアプリに埋め込まれる前提のもの。Secret key は絶対に置かない。
#
# 未設定のままだと課金機能は無効になり(billingEnabled() が false)、
# 起動時の購読ゲートも設定画面の課金導線も出ない(開発中はこれで全画面を確認できる)。
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# スクリーンショット撮影用の抜け道。1 にすると課金機能ごと無効になり、
# 起動時の購読ゲートも課金の導線も出なくなる(APIキー未設定と同じ状態)。
#
# シミュレータや、審査前の商品では StoreKit がプランを返さないため、
# APIキー入りのビルドだとペイウォールで止まって中の画面を撮れない。そのための逃げ道。
# __DEV__ のときしか見ないので、本番ビルドに紛れ込んでも効かない。
EXPO_PUBLIC_SKIP_PAYWALL=

# 開発中に「購読者」として起動するための App User ID。
# RevenueCat ダッシュボードで promotional entitlement を付けた相手の ID を入れる
# (Customers → 対象 → App User ID をそのままコピー)。
#
# 匿名IDのままだと付与した権利が届かないので、この指定が要る。
# SKIP_PAYWALL と違って課金機能は生きたままなので、AI献立提案も通る。
# こちらも __DEV__ のときしか見ない。
EXPO_PUBLIC_DEV_APP_USER_ID=

# ペイウォールに出すダミーの価格(例: ¥1,500)。App内課金の審査用スクリーンショットを
# 撮るためのもの。シミュレータには StoreKit の商品情報が無く、ペイウォールが
# 「取得できませんでした」で止まって価格の出た画面を撮れないため。
#
# SKIP_PAYWALL と違い __DEV__ 限定ではない(EAS の simulator ビルドはリリースビルドで
# __DEV__ が false になり、あちらが効かないため)。本番ビルドの環境変数には絶対に入れないこと。
# 設定した値がそのまま画面に出るので、App Store Connect の実際の価格と一致させること。
#
# EAS で撮影用ビルドを作る場合は eas.json の screenshot プロファイルを使う。
EXPO_PUBLIC_MOCK_PLAN_PRICE=

# 計測(Layers SDK)の appId。ダッシュボードのアプリ設定からコピーする。
# 公開前提の識別子なのでクライアントバンドルに入ってよい(秘密鍵は絶対に置かない)。
# 未設定の間は計測機能ごと無効(AnalyticsProvider が素通しになる)。
# EAS ビルドでは eas.json の env かプロジェクトの環境変数として渡す。
EXPO_PUBLIC_LAYERS_APP_ID=

# AI献立提案の中継サーバー(workers/ai-proxy をデプロイしたURL)。
# 例: https://tabenote-ai.xxx.workers.dev
# 未設定の間はアドバイス画面にAI欄が出ない。v1.0 の提出前に必ず設定すること
# (サブスクで解放される機能なので、無いと審査に通らない)。
EXPO_PUBLIC_AI_PROXY_URL=
