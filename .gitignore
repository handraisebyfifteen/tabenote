# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
/tabenote-legal/

# Replit のシステムフォルダ。
# git はシステムの core.excludesFile (/etc/.gitignore) でこれらを無視するが、
# EAS CLI は未追跡ファイルを集める際にこのファイルしか解釈せず core.excludesFile を
# 見ないため、ここに書かないと数GBがビルドの tarball に混入する。
.cache/
.config/
.local/
.upm/
.agents/
.breakpoints
.env
*.log
