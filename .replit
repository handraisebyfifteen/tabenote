modules = ["nodejs-20", "web", "postgresql-16"]
run = "BROWSER=none EXPO_UNSTABLE_HEADLESS=1 npx expo start --web --port 5000"
hidden = [".config", ".git", "node_modules", ".expo", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3003

[[ports]]
localPort = 5099
externalPort = 5000

[[ports]]
localPort = 5100
externalPort = 4200

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8090
externalPort = 3001

[[ports]]
localPort = 8097
externalPort = 3000

[[ports]]
localPort = 8099
externalPort = 8099

[workflows]
runButton = "tabenote"

[[workflows.workflow]]
name = "tabenote"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BROWSER=none EXPO_UNSTABLE_HEADLESS=1 npx expo start --web --port 5000"
waitForPort = 5000

[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["npm", "run", "build:web"]
