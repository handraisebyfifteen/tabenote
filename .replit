modules = ["nodejs-20", "web"]
run = "npx expo start --web --port 8081"
hidden = [".config", ".git", "node_modules", ".expo", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8090
externalPort = 3001

[workflows]
runButton = "tabenote"

[[workflows.workflow]]
name = "tabenote"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --web --port 8081"
waitForPort = 8081

[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["npx", "expo", "export", "--platform", "web"]
