{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "screenshot": {
      "extends": "simulator",
      "env": {
        "EXPO_PUBLIC_MOCK_PLAN_PRICE": "¥1,000"
      }
    },
    "screenshot-app": {
      "extends": "simulator",
      "env": {
        "EXPO_PUBLIC_SKIP_PAYWALL": "1"
      }
    },
    "demo": {
      "extends": "simulator",
      "env": {
        "EXPO_PUBLIC_DEMO": "1",
        "EXPO_PUBLIC_SKIP_PAYWALL": "1"
      }
    },
    "screenshot-subscriber": {
      "extends": "simulator",
      "env": {
        "EXPO_PUBLIC_DEV_APP_USER_ID": "test_user"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6802138763"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
